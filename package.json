{
  "name": "mise-tui",
  "version": "0.1.3",
  "description": "A lightweight TUI wrapper for mise.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liao666brant/mise-tui.git"
  },
  "type": "module",
  "files": [
    "dist/index.cjs"
  ],
  "bin": {
    "mt": "dist/index.cjs",
    "mise-tui": "dist/index.cjs"
  },
  "scripts": {
    "start": "bun ./src/index.ts",
    "build": "bun ./scripts/build.ts",
    "check": "tsc --noEmit && bun run build",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "keywords": [
    "mise",
    "tui",
    "cli",
    "bun"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
