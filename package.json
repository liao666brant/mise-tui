{
  "name": "mise-tui",
  "version": "0.1.2",
  "description": "A lightweight TUI wrapper for mise.",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "mt": "./dist/index.js",
    "mise-tui": "./dist/index.js"
  },
  "scripts": {
    "start": "bun ./src/index.ts",
    "build": "bun build ./src/index.ts --target bun --outfile ./dist/index.js",
    "check": "tsc --noEmit && bun run build",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.14",
  "keywords": [
    "mise",
    "tui",
    "cli",
    "bun"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
